{
  "name": "dsh-claw-observability",
  "version": "0.3.0-rc.2",
  "description": "Shared structured diagnostics and a Settings page for the DSH Claw plugin suite. 治理插件共用诊断日志与运行诊断页。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "observability"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./host.js",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./observe": "./observe.mjs",
    "./codes": "./codes.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "host.js",
    "client.js",
    "observe.mjs",
    "observe-filter.mjs",
    "observe-i18n.mjs",
    "observe-styles.mjs",
    "observe-page.mjs",
    "observe-runtime.mjs",
    "codes.mjs",
    "sanitize.mjs",
    "store.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "build:check": "node scripts/build-client.mjs --check",
    "test": "npm run build:check && node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "dsh-claw-core": "0.3.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.0-rc.1"
  }
}
