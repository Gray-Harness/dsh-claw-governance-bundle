 "keywords": [
  "dsh",
  "dsh-plugin",
  "deepseek-harness",
  "claw",
  "core"
 ],
 "license": "MIT",
 "type": "module",
 "main": "./index.mjs",
 "exports": {
  ".": "./index.mjs",
  "./live-agents": "./live-agents.mjs",
  "./session-classifier": "./session-classifier.mjs",
  "./path-containment": "./path-containment.mjs",
  "./errors": "./errors.mjs",
  "./http": "./http.mjs",
  "./version": "./version.mjs",
  "./package.json": "./package.json"
 },
 "files": [
  "index.mjs",
  "live-agents.mjs",
  "session-classifier.mjs",
  "path-containment.mjs",
  "errors.mjs",
  "http.mjs",
  "version.mjs",
  "README.md",
  "LICENSE"
 ],
 "engines": {
  "node": ">=20"
 },
 "scripts": {
