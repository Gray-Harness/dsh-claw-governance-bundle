  ".": "./host.js",
  "./package.json": "./package.json"
 },
 "files": [
  "host.js",
  "delegate-depth.mjs",
  "delegate-policy.mjs",
  "delegate-store.mjs",
  "delegate-worktree.mjs",
  "delegate-sandbox.mjs",
  "delegate-context.mjs",
  "delegate-role.mjs",
  "delegate-budget.mjs",
  "delegate-handoff.mjs",
  "delegate-deliver.mjs",
  "cordis.patch.yml",
  "README.md",
  "LICENSE"
 ],
 "engines": {
  "node": ">=20"
 },
 "scripts": {
  "test": "node --test test/*.test.mjs"
 },
 "dependencies": {
  "dsh-claw-core": "git+https://github.com/Gray-Harness/dsh-claw-governance-bundle.git#9c115ccf6e3ae30b6d92cf171204fa4adeb4779b&path:/plugins/dsh-claw-core",
  "dsh-claw-permissions": "git+https://github.com/Gray-Harness/dsh-claw-governance-bundle.git#9c115ccf6e3ae30b6d92cf171204fa4adeb4779b&path:/plugins/dsh-claw-permissions",
  "dsh-claw-policy": "git+https://github.com/Gray-Harness/dsh-claw-governance-bundle.git#9c115ccf6e3ae30b6d92cf171204fa4adeb4779b&path:/plugins/dsh-claw-policy",
  "dsh-claw-observability": "git+https://github.com/Gray-Harness/dsh-claw-governance-bundle.git#9c115ccf6e3ae30b6d92cf171204fa4adeb4779b&path:/plugins/dsh-claw-observability"
 },
 "peerDependencies": {
  "@deepseek-ai/dsh": "^0.2.0-rc.1"
 },
 "dsh": {
  "bundle": {
   "patch": "./cordis.patch.yml"
  }
 }
}
