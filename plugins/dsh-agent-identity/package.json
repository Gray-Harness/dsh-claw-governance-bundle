{
  "name": "dsh-claw-identity",
  "version": "0.3.0-rc.2",
  "description": "Claw agent identity for DeepSeek Harness: injects each agent's persona files (SOUL / AGENTS / USER …) into its prompt. 把每个 Claw Agent 的人设文件打进它的提示词。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent",
    "identity"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./host.js",
  "exports": {
    ".": "./host.js",
    "./package.json": "./package.json",
    "./files": "./identity-files.mjs"
  },
  "files": [
    "host.js",
    "identity-files.mjs",
    "identity-memory.mjs",
    "identity-heartbeat.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "dsh-claw-core": "0.3.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.0-rc.1"
  }
}
